{
  "name": "fixmytype-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "pretest": "npm run build:worker",
    "build:worker": "cargo build --locked --manifest-path ../input-worker/Cargo.toml",
    "test": "vitest run",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:phase2": "node scripts/phase2-check.mjs",
    "test:targets": "node scripts/target-check.mjs",
    "test:calibration": "node scripts/target-check.mjs calibration",
    "test:word": "node scripts/target-check.mjs word",
    "test:repair": "node scripts/target-check.mjs repair",
    "test:workflow": "electron scripts/workflow-smoke.cjs",
    "test:runtime": "node scripts/runtime-check.mjs",
    "setup:speech": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-speech.ps1",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "npm run build:worker && npm run typecheck && npm run build:renderer && npm run build:main"
  },
  "dependencies": {
    "docx": "9.7.1",
    "electron": "^44.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "jszip": "3.10.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
